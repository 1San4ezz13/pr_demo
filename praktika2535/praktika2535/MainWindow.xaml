<Window x:Class="praktika2535.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:praktika2535"
        mc:Ignorable="d"
        Title="Магазин обуви" Height="450" Width="800"
        MinHeight = "650" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#D2F6E7">
            <Label Content="Магазин обуви" FontSize="30"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"></Label>
            <Image Source="/Resources/Чудо Обувь.png"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="200,0,0,0"></Image>
            <Frame x:Name="MainFrame" Grid.Row="1"
               NavigationUIVisibility="Hidden" ></Frame>
        </Grid>
    </Grid>
</Window>
